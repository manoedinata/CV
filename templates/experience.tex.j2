{%- for job in data.work -%}
    \entry
    {
    {%- if job.url -%}
        << href(job.url, job.name) >>
    {%- else -%}
        << job.name | escape_tex >>
    {%- endif -%}
    }
    {<< job.location | escape_tex >>}
    {<< job.position | escape_tex >>}
    {<< job.startDate | escape_tex | date_format >> --
    {% if job.endDate -%}
        << job.endDate | escape_tex | date_format >>
    {% else -%}
        Present
    {%- endif -%}
    }
    {
    {%- for detail in job.highlights -%}
        \item << detail | escape_tex>>
    {%- endfor -%}
    }
{%- endfor -%}
