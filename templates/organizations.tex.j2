\entry
{%- for org in data.organization -%}
    {<< org.name | escape_tex >>}
    {<< org.location | escape_tex >>}
    {<< org.position | escape_tex >>}
    {<< org.startDate | escape_tex | date_format >> --
    {%- if org.endDate -%}
        << org.endDate | escape_tex | date_format >>
    {%- else -%}
        Present
    {%- endif -%}
    }
    {
    {%- for detail in org.highlights -%}\item << detail | escape_tex>>{%- endfor -%}
        }
    {%- endfor -%}
