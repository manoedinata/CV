{%- for vol in data.volunteer -%}
    \entry
    {<< vol.organization | escape_tex >>}
    {<< vol.location | escape_tex >>}
    {<< vol.position | escape_tex >>}
    {<< vol.startDate | escape_tex | date_format >> --
    {%- if vol.endDate -%}
        << vol.endDate | escape_tex | date_format >>
    {%- else -%}
        Present
    {%- endif -%}
    }
    {
    {% for detail in vol.highlights %}\item << detail | escape_tex>>{% endfor %}
    }
{%- endfor -%}
