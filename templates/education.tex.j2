{%- for edu in data.education -%}
    \entry
    {<< edu.institution | escape_tex >>}
    {<< edu.location | escape_tex >>}
    {<< edu.area | escape_tex >>
    {%- if edu.score %} (Grade: << edu.score | escape_tex >>){%- endif -%}
        }
        {<< edu.startDate | escape_tex | date_format >> --
        {% if edu.endDate -%}
            << edu.endDate | escape_tex | date_format >>
        {% else -%}
            Present
        {%- endif -%}
        }
        {%- if edu.courses -%}
            {
            {%- for detail in edu.courses -%}
                \item << detail | escape_tex>>
            {%- endfor -%}
            }
        {%- else -%}
            {}
        {%- endif -%}
        {%- endfor -%}
