<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ data.basics.name }}</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />

    <style>
      :root {
        /* Color Palette */
        --primary-color: #198754; /* Bootstrap Success Green */
        --secondary-color: #64748b; /* Slate Gray */
        --dark-color: #0f172a; /* Deep Navy */
        --light-bg: #f8fafc; /* Off-white */
        --white: #ffffff;
        --accent-glow: rgba(37, 99, 235, 0.1);
      }

      body {
        font-family: "Inter", sans-serif;
        color: var(--dark-color);
        background-color: var(--white);
        line-height: 1.6;
        overflow-x: hidden;
        position: relative; /* Needed for absolute bg positioning */
      }

      /* --- Background Animation --- */
      .area {
        background: -webkit-linear-gradient(to left, #8f94fb, #4e54c8);
        width: 100%;
        height: 100vh;
        position: fixed; /* Fixed so it stays while scrolling */
        top: 0;
        left: 0;
        z-index: -1; /* Behind content */
        pointer-events: none; /* Let clicks pass through */
      }

      .circles {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        margin: 0;
        padding: 0;
      }

      .circles li {
        position: absolute;
        display: block;
        list-style: none;
        width: 20px;
        height: 20px;
        background: var(--primary-color);
        animation: animate 25s linear infinite;
        bottom: -150px;
        opacity: 0.1; /* Very subtle */
        border-radius: 4px; /* Slight rounding for a tech look */
      }

      /* Randomize position, size, and delay for organic feel */
      .circles li:nth-child(1) {
        left: 25%;
        width: 80px;
        height: 80px;
        animation-delay: 0s;
      }

      .circles li:nth-child(2) {
        left: 10%;
        width: 20px;
        height: 20px;
        animation-delay: 2s;
        animation-duration: 12s;
      }

      .circles li:nth-child(3) {
        left: 70%;
        width: 20px;
        height: 20px;
        animation-delay: 4s;
      }

      .circles li:nth-child(4) {
        left: 40%;
        width: 60px;
        height: 60px;
        animation-delay: 0s;
        animation-duration: 18s;
      }

      .circles li:nth-child(5) {
        left: 65%;
        width: 20px;
        height: 20px;
        animation-delay: 0s;
      }

      .circles li:nth-child(6) {
        left: 75%;
        width: 110px;
        height: 110px;
        animation-delay: 3s;
      }

      .circles li:nth-child(7) {
        left: 35%;
        width: 150px;
        height: 150px;
        animation-delay: 7s;
      }

      .circles li:nth-child(8) {
        left: 50%;
        width: 25px;
        height: 25px;
        animation-delay: 15s;
        animation-duration: 45s;
      }

      .circles li:nth-child(9) {
        left: 20%;
        width: 15px;
        height: 15px;
        animation-delay: 2s;
        animation-duration: 35s;
      }

      .circles li:nth-child(10) {
        left: 85%;
        width: 150px;
        height: 150px;
        animation-delay: 0s;
        animation-duration: 11s;
      }

      @keyframes animate {
        0% {
          transform: translateY(0) rotate(0deg);
          opacity: 0.1;
          border-radius: 0;
        }
        100% {
          transform: translateY(-1000px) rotate(720deg);
          opacity: 0.4;
          border-radius: 50%;
        }
      }

      /* --- Navbar --- */
      .navbar {
        backdrop-filter: blur(12px);
        background-color: rgba(
          255,
          255,
          255,
          0.85
        ); /* Slightly more transparent for bg */
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        padding: 1rem 0;
        transition: all 0.3s ease;
      }
      .navbar-brand {
        font-weight: 700;
        color: var(--primary-color) !important;
        letter-spacing: -0.5px;
      }
      .nav-link {
        font-weight: 500;
        color: var(--secondary-color);
        margin: 0 10px;
        transition: color 0.3s;
      }
      .nav-link:hover,
      .nav-link.active {
        color: var(--primary-color);
      }

      /* --- Hero Section --- */
      .hero-section {
        padding: 120px 0 100px;
        /* Removed radial gradient to let animated bg show through more */
        background: transparent;
        min-height: 90vh;
        display: flex;
        align-items: center;
      }

      @keyframes float-profile {
        0% {
          transform: translateY(0px);
        }
        50% {
          transform: translateY(-20px);
        }
        100% {
          transform: translateY(0px);
        }
      }

      .profile-wrapper {
        position: relative;
        display: inline-block;
        animation: float-profile 4s ease-in-out infinite;
      }
      .profile-wrapper:hover {
        animation-play-state: paused;
      }

      .profile-img {
        width: 225px;
        height: 225px;
        object-fit: cover;
        border-radius: 20px;
        box-shadow: 20px 20px 60px rgba(0, 0, 0, 0.1);
        transform: rotate(-3deg);
        transition: transform 0.4s ease;
        border: 4px solid white;
        background: white; /* Ensure transparency doesn't show through image */
      }

      /* Desktop sizing for image */
      @media (min-width: 992px) {
        .profile-img {
          width: 285px;
          height: 285px;
        }
      }

      .profile-wrapper:hover .profile-img {
        transform: rotate(0deg) scale(1.02);
      }

      /* --- Section Styling --- */
      section {
        padding: 100px 0;
        position: relative;
        z-index: 1; /* Ensure sections sit above background */
      }
      .bg-subtle {
        /* Semi-transparent background for readability */
        background-color: rgba(248, 250, 252, 0.85);
        backdrop-filter: blur(5px);
      }
      .section-header {
        margin-bottom: 60px;
      }
      .section-title {
        font-weight: 800;
        margin-bottom: 15px;
        position: relative;
        display: inline-block;
      }
      .section-title::after {
        content: "";
        position: absolute;
        bottom: -8px;
        left: 0;
        width: 40%;
        height: 4px;
        background: var(--primary-color);
        border-radius: 2px;
      }

      /* --- Timeline (Experience) --- */
      .timeline {
        position: relative;
        padding-left: 2rem;
        border-left: 2px solid #e2e8f0;
      }
      .timeline-item {
        position: relative;
        margin-bottom: 3rem;
      }
      .timeline-item:last-child {
        margin-bottom: 0;
      }
      .timeline-marker {
        position: absolute;
        left: -2.6rem;
        top: 0.25rem;
        width: 1.2rem;
        height: 1.2rem;
        background: var(--white);
        border: 3px solid var(--primary-color);
        border-radius: 50%;
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
      }
      .timeline-date {
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--primary-color);
        margin-bottom: 0.5rem;
        display: block;
      }

      /* --- Cards (Education & Projects) --- */
      .custom-card {
        border: none;
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.9); /* Slight transparency */
        backdrop-filter: blur(5px);
        box-shadow:
          0 4px 6px -1px rgba(0, 0, 0, 0.05),
          0 2px 4px -1px rgba(0, 0, 0, 0.03);
        transition:
          transform 0.3s ease,
          box-shadow 0.3s ease;
        height: 100%;
        overflow: hidden;
      }
      .custom-card:hover {
        transform: translateY(-5px);
        box-shadow:
          0 20px 25px -5px rgba(0, 0, 0, 0.1),
          0 10px 10px -5px rgba(0, 0, 0, 0.04);
      }
      .card-body {
        padding: 2rem;
      }

      /* --- Skill Pills --- */
      .skill-group h5 {
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--secondary-color);
        margin-bottom: 1rem;
      }
      .skill-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.5rem 1rem;
        margin: 0.25rem;
        background: var(--white);
        border: 1px solid #e2e8f0;
        border-radius: 50px;
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--dark-color);
        transition: all 0.2s;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
      }
      .skill-badge:hover {
        border-color: var(--primary-color);
        background: var(--primary-color);
        color: white;
      }
      .skill-badge i {
        margin-right: 8px;
      }

      /* --- Footer --- */
      .footer {
        background-color: var(--dark-color);
        color: #94a3b8;
        padding: 60px 0 30px;
        position: relative;
        z-index: 1;
      }
      .social-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 45px;
        height: 45px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 50%;
        color: white;
        margin: 0 10px;
        transition: all 0.3s;
        text-decoration: none;
      }
      .social-link:hover {
        background: var(--primary-color);
        transform: translateY(-3px);
        color: white;
      }

      /* Responsive */
      @media (max-width: 768px) {
        .hero-section {
          text-align: center;
          padding-top: 100px;
        }
        .profile-wrapper {
          margin-bottom: 40px;
        }
        .section-title::after {
          left: 50%;
          transform: translateX(-50%);
        }
        .timeline {
          border-left: none;
          padding-left: 0;
        }
        .timeline-marker {
          display: none;
        }
        .timeline-item {
          border-left: 2px solid var(--primary-color);
          padding-left: 1.5rem;
        }
      }
    </style>
  </head>
  <body data-bs-spy="scroll" data-bs-target="#mainNav" data-bs-offset="100">
    <div class="area">
      <ul class="circles">
        <li></li>
        <li></li>
        <li></li>
        <li></li>
        <li></li>
        <li></li>
        <li></li>
        <li></li>
        <li></li>
        <li></li>
      </ul>
    </div>

    <nav
      class="navbar navbar-expand-lg fixed-top"
      id="mainNav"
      data-aos="fade-down"
      data-aos-duration="800"
    >
      <div class="container">
        <a class="navbar-brand" href="#">ndra.</a>
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarNav"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div
          class="collapse navbar-collapse justify-content-end"
          id="navbarNav"
        >
          <ul class="navbar-nav">
            <li class="nav-item">
              <a class="nav-link active" href="#home">Home</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="#about">About</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="#experience">Experience</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="#education">Education</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="#projects">Projects</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="#skills">Skills</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="resume.pdf" target="_blank">CV</a>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <section id="home" class="hero-section">
      <div class="container">
        <div class="row align-items-center flex-column-reverse flex-lg-row">
          <div
            class="col-lg-7 text-center text-lg-start"
            data-aos="fade-up"
            data-aos-duration="1000"
          >
            <h1 class="display-3 fw-bold mb-3">
              Hi, I'm <span class="text-success">{{ data.basics.name }}</span>
            </h1>
            <h2 class="h3 text-secondary fw-light mb-4">
              {{ data.basics.label }}
            </h2>
            <p class="lead mb-5 text-secondary">
              Creating innovative solutions to solve real-world problems.
              Passionate about robotics, cyber security, and building efficient
              autonomous systems.
            </p>
            <div
              class="d-flex gap-3 justify-content-center justify-content-lg-start"
            >
              <a
                href="#experience"
                class="btn btn-success btn-lg rounded-pill px-5 shadow-sm"
                >Experiences</a
              >
              <!-- <a
                href="mailto:hendra@mdinata.my.id"
                class="btn btn-outline-dark btn-lg rounded-pill px-5"
                >Contact</a
              > -->
            </div>
          </div>
          <div
            class="col-lg-5 text-center mb-4 mb-lg-0"
            data-aos="fade-up"
            data-aos-duration="1000"
            data-aos-delay="200"
          >
            <div class="profile-wrapper">
              <img
                {% if data.basics.image %}
                  src="{{ data.basics.image }}"
                {% else %}
                  src="me.png"
                {% endif %}
                alt="Hendra Manudinata"
                class="profile-img"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="about" class="bg-subtle">
      <div class="container" data-aos="fade-up" data-aos-duration="1000">
        <div class="row justify-content-center">
          <div class="col-lg-8 text-center">
            <div class="section-header">
              <h2 class="section-title">About Me</h2>
            </div>
            <p class="fs-5 text-secondary">{{ data.basics.summary }}</p>
          </div>
        </div>
      </div>
    </section>

    <section id="experience">
      <div class="container">
        <div class="section-header text-center" data-aos="fade-up">
          <h2 class="section-title">Work Experience</h2>
        </div>
        <div class="row justify-content-center">
          <div class="col-lg-9">
            <div class="timeline">
              {% for work in data.work %}
                <div
                  class="timeline-item"
                  data-aos="fade-up"
                  data-aos-delay="100"
                >
                  <span class="timeline-marker"></span>
                  <span class="timeline-date">
                    {{ work.startDate | date_format }} -
                    {% if work.endDate -%}
                      {{ work.endDate | date_format }}
                    {% else -%}
                      Present
                    {%- endif -%}
                  </span>
                  <div class="card shadow-sm border-0">
                    <div class="card-body">
                      <h4 class="fw-bold">{{ work.name }}</h4>
                      <h5 class="text-success mb-3">{{ work.position }}</h5>
                      <ul class="text-secondary mb-0 ps-3">
                        {% for highlight in work.highlights %}
                          <li>{{ highlight }}</li>
                        {% endfor %}
                      </ul>
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="education" class="bg-subtle">
      <div class="container">
        <div class="section-header text-center" data-aos="fade-up">
          <h2 class="section-title">Education</h2>
        </div>
        <div class="row g-4">
          {% for education in data.education %}
            <div class="col-md-6" data-aos="flip-up" data-aos-delay="100">
              <div class="custom-card">
                <div class="card-body">
                  <div class="d-flex align-items-center mb-3">
                    <i class="fas fa-university fa-2x text-success me-3"></i>
                    <div>
                      <span class="text-muted small">
                        {{ education.startDate | date_format }} -
                        {% if education.endDate -%}
                          {{ education.endDate | date_format }}
                        {% else -%}
                          Present
                        {%- endif -%}
                      </span>
                      <h5 class="fw-bold mb-0">{{ education.institution }}</h5>
                    </div>
                  </div>
                  <p class="text-secondary mb-0">
                    Major: <strong>{{ education.area }}</strong>
                  </p>
                  {% if education.score %}
                    <p class="badge bg-success bg-opacity-10 text-success mt-2">
                      Score: {{ education.score }}
                    </p>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </section>

    <section id="projects">
      <div class="container">
        <div class="section-header text-center" data-aos="fade-up">
          <h2 class="section-title">Featured Projects</h2>
        </div>
        <div class="row g-4">
          {% for project in data.projects %}
            {% set descriptions = project.description.split('.') %}
            <div class="col-md-6" data-aos="zoom-in" data-aos-delay="100">
              <div class="custom-card">
                <div class="card-body d-flex flex-column">
                  <div
                    class="d-flex justify-content-between align-items-start mb-3"
                  >
                    <div>
                      <h4 class="fw-bold">{{ project.name }}</h4>
                      {% if project.url %}
                        <a
                          href="{{ project.url }}"
                          target="_blank"
                          class="text-decoration-none small"
                          >{{ project.url }}
                          <i class="fas fa-external-link-alt ms-1"></i
                        ></a>
                      {% endif %}
                      <p class="text-success small mb-0">
                        {{ descriptions | first }}
                      </p>
                    </div>
                    <div class="bg-light rounded-circle p-2">
                      <i class="fas fa-project-diagram text-success"></i>
                    </div>
                  </div>
                  <p class="text-secondary flex-grow-1">
                    {{ descriptions[1:] | join('. ') }}
                  </p>
                  <div class="mt-3">
                    {% for tag in project.keywords %}
                      <span class="badge bg-light text-dark border"
                        >{{ tag }}</span
                      >
                    {% endfor %}
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </section>

    <section id="skills" class="bg-subtle">
      <div class="container">
        <div class="section-header text-center" data-aos="fade-up">
          <h2 class="section-title">Skills & Tools</h2>
        </div>

        <div class="row g-4">
          {% for skill in data.skills %}
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
              <div class="skill-group text-center text-md-start">
                <h5>{{ skill.name }}</h5>
                <div>
                  {%- for keyword in skill.keywords -%}
                    <span class="skill-badge">{{ keyword }}</span>
                  {%- endfor -%}
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </section>

    <footer class="footer">
      <div class="container text-center">
        <div class="mb-4">
          {% for profile in data.basics.profiles %}
            <a
              href="https://{{ profile.url }}"
              target="_blank"
              class="social-link"
              ><i class="fab fa-{{ profile.network | lower }}"></i
            ></a>
          {% endfor %}
        </div>
        <p class="mb-0">© 2026 Hendra Manudinata</p>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
      AOS.init({
        once: true /* Animation happens only once while scrolling down */,
        offset: 100 /* Offset (in px) from the original trigger point */,
      });
    </script>
  </body>
</html>
